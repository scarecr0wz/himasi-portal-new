# Database (PostgreSQL only - per project rules)
# Pakai user/database dari scripts/init-db.sql (user: himasi_portal, password: himasi_portal_secret)
# Atau jalankan: ./scripts/setup-db.sh (bikin user PG + DB + schema + seed)
DATABASE_URL="postgresql://himasi_portal:himasi_portal_secret@localhost:5432/himasi_portal?schema=public"

# JWT (auth token - analogous to Laravel Sanctum)
JWT_SECRET="change-me-in-production-min-32-chars"
JWT_ISSUER="himasi-portal"
JWT_AUDIENCE="himasi-portal"

# Server
PORT=3001

# Optional: base URL for avatar etc (e.g. http://localhost:3001)
APP_URL="http://localhost:3001"
